{
  "label": "Cryptocurrency",
  "csv": {
    "filename_pattern": "^(\\d+_[A-Z]+_.+|[A-Z0-9]+-[A-Z0-9]+_[A-Z0-9]+_LAST_OHLCV)\\.csv$",
    "filename_description": "Flat: id_SYMBOL_Name.csv (e.g., 1_BTC_Bitcoin.csv). Nested layout: scan the <venue> folder containing <BASE-QUOTE>/YYYY/MM/<daily>.csv (e.g., scan D:\\crypto_yyy\\binance which holds binance/AAVE-USD/2021/02/01.csv)",
    "required_columns": [
      "timestamp",
      "open",
      "high",
      "low",
      "close",
      "volume"
    ],
    "optional_columns": [
      "vwap"
    ],
    "timestamp_column": "timestamp",
    "timestamp_format": "auto",
    "delimiter": ","
  },
  "instrument": {
    "type": "CurrencyPair",
    "quote_currency": "USD",
    "price_precision": 4,
    "size_precision": 0,
    "currency_type": 1,
    "timeframe": "1-MINUTE"
  },
  "trading": {
    "maker_fee": "0.001",
    "taker_fee": "0.001",
    "margin_init": "1.0",
    "margin_maint": "0.35"
  }
}